{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "node": "22.11.0",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.11.0",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyId": "$ASC_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID",
        "ascAppId": "6804193733",
        "appleTeamId": "AFPS3YND5F"
      }
    }
  }
}
