{
  "expo": {
    "name": "Yumurcak — Kreş ve Anaokulu Takip",
    "slug": "yumurcak-app-",
    "scheme": "yumurcak",
    "version": "1.2.6",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/522bbf0b-0a2c-4198-93b8-429848df9a43"
    },
    "extra": {
      "eas": {
        "projectId": "522bbf0b-0a2c-4198-93b8-429848df9a43"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.furukcell.yumurcakapp"
    },
    "android": {
      "package": "com.furukcell.yumurcakapp",
      "allowBackup": false,
      "versionCode": 27,
      "googleServicesFile": "./google-services.json",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Yumurcak fotoğraf ve videoları göstermek için galeri erişimi ister.",
          "savePhotosPermission": "Yumurcak fotoğraf ve videoları cihaz galerisine kaydetmek için galeri erişimi ister.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yumurcak fotoğraf ve videoları galeriden seçmek için erişim ister.",
          "cameraPermission": "Yumurcak kamerayı kullanmak için izin ister."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C3DEB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Yumurcak, servis rotasında sıradaki durağa olan mesafeyi göstermek için konumunuzu kullanır.",
          "locationWhenInUsePermission": "Yumurcak, servis rotasında sıradaki durağa olan mesafeyi göstermek için konumunuzu kullanır.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "bilimcocuk": {
            "image": "./assets/brand-icons/bilimcocuk.png",
            "prerendered": true
          },
          "harikacocuklar": {
            "image": "./assets/brand-icons/harikacocuklar.png",
            "prerendered": true
          }
        }
      ],
      "./plugins/withJvmTargetFix.js",
      "./plugins/withAllowBackupFix.js"
    ]
  }
}
