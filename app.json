{
  "expo": {
    "name": "Yumurcak Kreş",
    "slug": "yumurcak-app-",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/522bbf0b-0a2c-4198-93b8-429848df9a43"
    },
    "extra": {
      "eas": {
        "projectId": "522bbf0b-0a2c-4198-93b8-429848df9a43"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.furukcell.yumurcakapp"
    },
    "android": {
      "package": "com.furukcell.yumurcakapp",
      "versionCode": 2,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Yumurcak fotoğraf ve videoları göstermek için galeri erişimi ister.",
          "savePhotosPermission": "Yumurcak fotoğraf ve videoları cihaz galerisine kaydetmek için izin ister.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
